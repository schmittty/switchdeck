# SwitchDeck settings — copied to .env by install.sh. Restart after edits:  docker compose up -d

# Image to run (set by install.sh; use :sha-xxxxxxx to pin a specific build)
SD_IMAGE=ghcr.io/schmittty/switchdeck:latest

# Ports (host networking, so these are the host's ports)
SD_HTTP_PORT=8080        # web UI + API (+ dashboard API /api/v1/summary)
SD_FW_PORT=8081          # plain HTTP firmware file server switches download from
SD_SYSLOG_PORT=5514      # UDP syslog receiver; adoption points switches here

# IP the switches use to reach this host (syslog target + firmware URLs). Blank = from your browser's URL.
SD_PUBLIC_HOST=

# Timers
SD_POLL_INTERVAL=30      # seconds between status polls
SD_BACKUP_INTERVAL=86400 # seconds between change-detect config backups

# First-run admin password. Blank = generated and printed in the log once.
SD_ADMIN_PASSWORD=

# 1 = add four simulated switches (lab demo without hardware). Set back to 0 for real use.
SD_DEMO=0

# Optional TLS for the UI: place files in the data volume and point to them.
# SD_TLS_CERT=/data/tls/cert.pem
# SD_TLS_KEY=/data/tls/key.pem
